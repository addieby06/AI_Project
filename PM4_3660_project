        "# @title FIX 4: Improved Confidence Calculator (3-Factor Scoring)\n",
        "\n",
        "def calculate_confidence(query, retrieved_metadata, answer):\n",
        "    \"\"\"\n",
        "    Calculate confidence based on three factors:\n",
        "    1. Number of relevant sources (20% weight)\n",
        "    2. Query-answer keyword alignment (40% weight)\n",
        "    3. Answer specificity (numbers, dates, artist names) (40% weight)\n",
        "    \"\"\"\n",
        "    confidence_score = 0.0\n",
        "    \n",
        "    # Factor 1: Number of sources (20% weight)\n",
        "    sources_available = len(retrieved_metadata)\n",
        "    # Normalize: 0-5 sources -> 0-1, cap at 1.0\n",
        "    sources_score = min(sources_available / 5, 1.0) * 0.2\n",
        "    confidence_score += sources_score\n",
        "    \n",
        "    # Factor 2: Query-answer alignment (40% weight)\n",
        "    # Check if key query terms appear in answer\n",
        "    query_words = set(query.lower().split())\n",
        "    answer_words = set(answer.lower().split())\n",
        "    # Remove common words\n",
        "    common_words = {'the', 'a', 'an', 'and', 'or', 'is', 'was', 'by', 'on', 'at', 'in', 'to', 'for', 'of', 'with'}\n",
        "    query_words = query_words - common_words\n",
        "    answer_words = answer_words - common_words\n",
        "    \n",
        "    if query_words:\n",
        "        keyword_overlap = len(query_words & answer_words) / len(query_words)\n",
        "    else:\n",
        "        keyword_overlap = 0.5\n",
        "    confidence_score += keyword_overlap * 0.4\n",
        "    \n",
        "    # Factor 3: Answer specificity (40% weight)\n",
        "    specificity_score = 0.0\n",
        "    \n",
        "    # Check for specific data indicators\n",
        "    has_numbers = any(char.isdigit() for char in answer)\n",
        "    if has_numbers:\n",
        "        specificity_score += 0.2\n",
        "    \n",
        "    # Check for artist names from metadata\n",
        "    has_artist = any(m['artist'].lower() in answer.lower() for m in retrieved_metadata if m)\n",
        "    if has_artist:\n",
        "        specificity_score += 0.2\n",
        "    \n",
        "    # Check for song names from metadata\n",
        "    has_song = any(m['song'].lower() in answer.lower() for m in retrieved_metadata if m)\n",
        "    if has_song:\n",
        "        specificity_score += 0.2\n",
        "    \n",
        "    # Check for dates\n",
        "    import re\n",
        "    if re.search(r'\\d{1,2}[/-]\\d{1,2}[/-]\\d{4}|\\d{4}', answer):\n",
        "        specificity_score += 0.2\n",
        "    \n",
        "    # Check for answer length (longer != better, but too short is suspicious)\n",
        "    if len(answer) > 50:\n",
        "        specificity_score += 0.2\n",
        "    \n",
        "    # Normalize to 0-1\n",
        "    specificity_score = min(specificity_score, 1.0)\n",
        "    confidence_score += specificity_score * 0.4\n",
        "    \n",
        "    return min(confidence_score, 1.0)\n",
        "\n",
        "def get_confidence_label(confidence_score):\n",
        "    \"\"\"\n",
        "    Map confidence score to user-friendly label with emoji.\n",
        "    \"\"\"\n",
        "    if confidence_score >= 0.80:\n",
        "        return (\"🟢 High\", \"#28a745\")\n",
        "    elif confidence_score >= 0.60:\n",
        "        return (\"🟡 Medium\", \"#ffc107\")\n",
        "    else:\n",
        "        return (\"🔴 Low\", \"#dc3545\")\n",
        "\n",
        "print(\"✅ Confidence calculator functions loaded\")"
      ],
