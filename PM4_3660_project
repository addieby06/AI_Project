        "# @title FIX 6: Enhanced Safety Guardrails\n",
        "\n",
        "def is_unsafe_query(query):\n",
        "    \"\"\"\n",
        "    Check if query should be refused.\n",
        "    Focuses on genuinely harmful content, not song names with problematic words.\n",
        "    \"\"\"\n",
        "    # Harmful intent keywords (avoid false positives on song names)\n",
        "    dangerous_keywords = [\n",
        "        \"bomb\", \"weapon\", \"drug\", \"hack\", \"steal\", \"harm\", \"kill\",\n",
        "        \"death\", \"violence\", \"illegal\", \"exploit\"\n",
        "    ]\n",
        "    \n",
        "    query_lower = query.lower()\n",
        "    \n",
        "    # Check if query is asking FOR HELP with dangerous activities\n",
        "    dangerous_patterns = [\n",
        "        \"how to\", \"teach me\", \"show me how\", \"explain how to\", \"tell me how to\"\n",
        "    ]\n",
        "    \n",
        "    is_asking = any(pattern in query_lower for pattern in dangerous_patterns)\n",
        "    is_dangerous = any(keyword in query_lower for keyword in dangerous_keywords)\n",
        "    \n",
        "    # Only block if both conditions are true (asking for help with dangerous activity)\n",
        "    return is_asking and is_dangerous\n",
        "\n",
        "def safe_query_handler(query, user_mode=\"casual\"):\n",
        "    \"\"\"\n",
        "    Main handler with safety checks and smart retrieval.\n",
        "    \"\"\"\n",
        "    # Validation checks\n",
        "    if not query or not query.strip():\n",
        "        return \"Please enter a question.\", None\n",
        "    \n",
        "    if is_unsafe_query(query):\n",
        "        return \"Sorry, I can't answer that question. I'm designed to help with music chart data only.\", None\n",
