        "# @title FIX 2: Smart Retrieval with Metadata Filtering\n",
        "\n",
        "def extract_filters_from_query(query):\n",
        "    \"\"\"\n",
        "    Extract filter hints from the user query.\n",
        "    Example: \"songs in 2021\" -> {\"year\": 2021}\n",
        "    \"\"\"\n",
        "    filters = {}\n",
        "    \n",
        "    # Extract year\n",
        "    import re\n",
        "    year_match = re.search(r'\\b(20\\d{2}|19\\d{2})\\b', query)\n",
        "    if year_match:\n",
        "        filters['year'] = int(year_match.group(1))\n",
        "    \n",
        "    # Extract month\n",
        "    months = {'january': 1, 'february': 2, 'march': 3, 'april': 4, 'may': 5, 'june': 6,\n",
        "              'july': 7, 'august': 8, 'september': 9, 'october': 10, 'november': 11, 'december': 12}\n",
        "    for month_name, month_num in months.items():\n",
        "        if month_name in query.lower():\n",
        "            filters['month'] = month_num\n",
        "            break\n",
        "    \n",
        "    # Extract rank\n",
        "    rank_match = re.search(r'rank[\\s#]*([0-9]+)|#([0-9]+)|number\\s([0-9]+)', query.lower())\n",
        "    if rank_match:\n",
        "        rank_str = rank_match.group(1) or rank_match.group(2) or rank_match.group(3)\n",
        "        filters['peak_rank'] = int(rank_str)\n",
        "    \n",
        "    return filters\n",
        "\n",
        "def filter_metadata_by_criteria(metadata_index, filters):\n",
        "    \"\"\"\n",
        "    Pre-filter metadata before semantic search.\n",
        "    Reduces irrelevant context and improves accuracy.\n",
        "    \"\"\"\n",
        "    filtered = metadata_index\n",
        "    \n",
        "    if 'year' in filters:\n",
        "        filtered = [m for m in filtered if m['year'] == filters['year']]\n",
        "    \n",
        "    if 'month' in filters:\n",
        "        filtered = [m for m in filtered if m['month'] == filters['month']]\n",
        "    \n",
        "    if 'peak_rank' in filters:\n",
        "        filtered = [m for m in filtered if m['peak_rank'] == filters['peak_rank']]\n",
        "    \n",
        "    if 'artist' in filters:\n",
        "        artist_term = filters['artist'].lower()\n",
        "        filtered = [m for m in filtered if artist_term in m['artist'].lower()]\n",
        "    \n",
        "    return filtered if filtered else metadata_index\n",
        "\n",
        "def normalize(v):\n",
        "    \"\"\"Normalize a vector to unit length.\"\"\"\n",
        "    v = np.array(v, dtype=np.float32)\n",
        "    norm = np.linalg.norm(v)\n",
        "    if norm < 1e-12:\n",
        "        return v\n",
        "    return v / norm\n",
        "\n",
        "def smart_retrieve(query, metadata_index, k=TOP_K):\n",
        "    \"\"\"\n",
        "    IMPROVED retrieval: metadata filter THEN semantic search.\n",
        "    This two-stage approach significantly improves accuracy.\n",
        "    \n",
        "    Args:\n",
        "        query: User query string\n",
        "        metadata_index: List of metadata entries\n",
        "        k: Number of results to return\n",
        "    \n",
        "    Returns:\n",
        "        List of top-k metadata entries\n",
        "    \"\"\"\n",
        "    # Stage 1: Extract and apply metadata filters\n",
        "    filters = extract_filters_from_query(query)\n",
        "    filtered_metadata = filter_metadata_by_criteria(metadata_index, filters)\n",
        "    \n",
        "    # Stage 2: Semantic search on filtered set\n",
        "    query_emb = get_text_embedding(query)\n",
        "    query_emb_normalized = normalize(query_emb)\n",
        "    \n",
        "    similarities = []\n",
        "    for meta in filtered_metadata:\n",
        "        text_emb = get_text_embedding(meta['text'])\n",
        "        text_emb_normalized = normalize(text_emb)\n",
        "        similarity = np.dot(text_emb_normalized, query_emb_normalized)\n",
        "        similarities.append(similarity)\n",
        "    \n",
        "    if not similarities:\n",
        "        # Fallback to unfiltered search\n",
        "        filtered_metadata = metadata_index\n",
        "        similarities = []\n",
        "        for meta in filtered_metadata:\n",
        "            text_emb = get_text_embedding(meta['text'])\n",
        "            text_emb_normalized = normalize(text_emb)\n",
        "            similarity = np.dot(text_emb_normalized, query_emb_normalized)\n",
        "            similarities.append(similarity)\n",
        "    \n",
        "    # Get top-k\n",
        "    top_indices = np.argsort(similarities)[-k:][::-1]\n",
        "    return [filtered_metadata[i] for i in top_indices]\n",
        "\n",
        "# Test smart retrieval\n",
        "test_query = \"What songs peaked at rank 2 in November 2021?\"\n",
        "retrieved = smart_retrieve(test_query, metadata_index, k=TOP_K)\n",
        "print(f\"✅ Retrieved {len(retrieved)} entries for query: '{test_query}'\")\n",
        "if retrieved:\n",
        "    print(f\"   Example: {retrieved[0]['song']} by {retrieved[0]['artist']}\")"
      ],
