        "# @title FIX 3: Stricter System Prompts\n",
        "\n",
        "SYSTEM_PROMPTS = {\n",
        "    \"strict\": \"\"\"You are a precise music data assistant with STRICT rules:\n",
        "\n",
        "MANDATORY RULES:\n",
        "1. ONLY use data provided in the context - NEVER make up information\n",
        "2. If information is not in the context, respond with: \"This information is not available in my dataset\"\n",
        "3. Always include exact numbers (weeks, ranks, dates)\n",
        "4. Always include full song names AND artist names\n",
        "5. If asked about trends or comparisons, ONLY compare data in context\n",
        "6. Format numbers consistently (e.g., \"3 weeks\", \"Rank #1\")\n",
        "7. DO NOT provide recommendations or suggestions beyond the data\n",
        "8. DO NOT answer questions about genres, lyrics, or non-chart-related topics\n",
        "9. DO NOT guess or infer anything\n",
        "\n",
        "When answering:\n",
        "- State the data point clearly\n",
        "- Include the date/context when relevant\n",
        "- Cite which songs/artists are included in your answer\"\"\",\n",
        "\n",
        "    \"casual\": \"\"\"You are a helpful, enthusiastic music expert for casual listeners.\n",
        "\n",
        "STYLE GUIDELINES:\n",
        "- Be conversational and engaging\n",
        "- Use relatable language (\"this song dominated the charts for 3 weeks\")\n",
        "- Include interesting context when available\n",
        "- Keep answers concise but informative (2-3 sentences)\n",
        "- Encourage exploration (\"would you like to know more about...\")\n",
        "- Make music appreciation fun!\n",
        "\n",
        "CRITICAL:\n",
        "- Stay factual to the data provided\n",
        "- If data isn't available, say so clearly\n",
        "- DO NOT make up facts or infer beyond the data\"\"\",\n",
        "\n",
        "    \"data_scientist\": \"\"\"You are a sophisticated data analyst for music researchers.\n",
        "\n",
        "ANALYSIS GUIDELINES:\n",
        "- Provide comprehensive statistical breakdowns\n",
        "- Include confidence measures and data limitations\n",
        "- Use precise terminology\n",
        "- Highlight patterns, anomalies, and trends\n",
        "- Acknowledge data gaps explicitly\n",
        "- Include calculations when relevant\n",
        "\n",
        "FORMAT REQUIREMENTS:\n",
        "- Use structured sections (Overview, Details, Statistical Significance)\n",
        "- Include exact numbers and percentages\n",
        "- Reference data completeness (e.g., \"Based on 47 chart entries...\")\n",
        "- Suggest follow-up analyses when relevant\n",
        "- ONLY reference data in the provided context\"\"\"\n",
        "}\n",
        "\n",
        "from openai import OpenAI\n",
        "client = OpenAI()\n",
        "\n",
        "def generate_answer_casual(query, context_text, retrieved_metadata):\n",
        "    \"\"\"\n",
        "    Generate conversational answer for casual users.\n",
        "    \"\"\"\n",
        "    prompt = f\"\"\"Context Data:\n",
        "{context_text}\n",
        "\n",
        "User Question: {query}\n",
        "\n",
        "Answer:\"\"\"\n",
        "    \n",
        "    response = client.chat.completions.create(\n",
        "        model=MODEL,\n",
        "        messages=[\n",
        "            {\"role\": \"system\", \"content\": SYSTEM_PROMPTS[\"casual\"]},\n",
        "            {\"role\": \"user\", \"content\": prompt}\n",
        "        ],\n",
        "        temperature=TEMPERATURE\n",
        "    )\n",
        "    return response.choices[0].message.content\n",
        "\n",
        "def generate_answer_data_scientist(query, context_text, retrieved_metadata):\n",
        "    \"\"\"\n",
        "    Generate detailed analytical answer for data scientists.\n",
        "    \"\"\"\n",
        "    # Calculate statistics from retrieved metadata\n",
        "    if retrieved_metadata:\n",
        "        avg_weeks = np.mean([m['weeks_on_chart'] for m in retrieved_metadata])\n",
        "        avg_rank = np.mean([m['rank'] for m in retrieved_metadata])\n",
        "        best_peak = min([m['peak_rank'] for m in retrieved_metadata])\n",
        "        stats_text = f\"\\nStatistics from {len(retrieved_metadata)} entries:\\n- Avg weeks on chart: {avg_weeks:.1f}\\n- Avg current rank: {avg_rank:.1f}\\n- Best peak rank: {best_peak}\"\n",
        "    else:\n",
        "        stats_text = \"\"\n",
        "    \n",
        "    prompt = f\"\"\"Context Data:\n",
        "{context_text}\n",
        "{stats_text}\n",
        "\n",
        "Query: {query}\n",
        "\n",
        "Detailed Analysis:\"\"\"\n",
        "    \n",
        "    response = client.chat.completions.create(\n",
        "        model=MODEL,\n",
        "        messages=[\n",
        "            {\"role\": \"system\", \"content\": SYSTEM_PROMPTS[\"data_scientist\"]},\n",
        "            {\"role\": \"user\", \"content\": prompt}\n",
        "        ],\n",
        "        temperature=0.3  # Lower temp for more deterministic output\n",
        "    )\n",
        "    return response.choices[0].message.content\n",
        "\n",
        "def generate_answer_strict(query, context_text, retrieved_metadata):\n",
        "    \"\"\"\n",
        "    Generate strict, fact-based answer with no hallucinations.\n",
        "    \"\"\"\n",
        "    prompt = f\"\"\"Context Data:\n",
        "{context_text}\n",
        "\n",
        "User Question: {query}\n",
        "\n",
        "Answer:\"\"\"\n",
        "    \n",
        "    response = client.chat.completions.create(\n",
        "        model=MODEL,\n",
        "        messages=[\n",
        "            {\"role\": \"system\", \"content\": SYSTEM_PROMPTS[\"strict\"]},\n",
        "            {\"role\": \"user\", \"content\": prompt}\n",
        "        ],\n",
        "        temperature=0.2  # Very low temp for strictness\n",
