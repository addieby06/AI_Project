      "source": [
        "# @title FIX 1: Create Metadata Index (Instead of Row-Based Chunking)\n",
        "\n",
        "def create_metadata_index(df, sample_size=None):\n",
        "    \"\"\"\n",
        "    Convert DataFrame into a structured metadata index.\n",
        "    This approach reduces token usage and improves accuracy for trend queries.\n",
        "    \n",
        "    Args:\n",
        "        df: Input DataFrame\n",
        "        sample_size: Optional - limit to N rows for testing\n",
        "    \n",
        "    Returns:\n",
        "        List of metadata dictionaries with structured information\n",
        "    \"\"\"\n",
        "    if sample_size:\n",
        "        df = df.head(sample_size)\n",
        "    \n",
        "    metadata_index = []\n",
        "    \n",
        "    for idx, row in df.iterrows():\n",
        "        metadata_entry = {\n",
        "            'id': idx,\n",
        "            'song': row['song'],\n",
        "            'artist': row['artist'],\n",
        "            'date': row['date'],\n",
        "            'year': row['year'],\n",
        "            'month': row['month'],\n",
        "            'rank': int(row['rank']),\n",
        "            'peak_rank': int(row['peak_rank']),\n",
        "            'weeks_on_chart': int(row['weeks_on_chart']),\n",
        "            'last_week': row['last_week'],\n",
        "            # Text representation for embedding\n",
        "            'text': f\"Song: {row['song']}, Artist: {row['artist']}, Peak Rank: {row['peak_rank']}, Weeks on Chart: {row['weeks_on_chart']}\"\n",
        "        }\n",
        "        metadata_index.append(metadata_entry)\n",
        "    \n",
        "    return metadata_index\n",
        "\n",
        "# Create metadata index for subset (first 500 for testing)\n",
        "metadata_index = create_metadata_index(df_clean, sample_size=500)\n",
        "print(f\"✅ Created metadata index with {len(metadata_index)} entries\")\n",
        "print(f\"   Example entry: {metadata_index[0]}\")"
