        "    if len(query) > MAX_INPUT_LENGTH:\n",
        "        return f\"Query too long (max {MAX_INPUT_LENGTH} characters).\", None\n",
        "    \n",
        "    return None, None  # All checks passed\n",
        "\n",
        "print(\"✅ Enhanced safety functions loaded\")"
